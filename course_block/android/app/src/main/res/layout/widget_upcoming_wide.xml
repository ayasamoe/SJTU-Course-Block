<?xml version="1.0" encoding="utf-8"?>
<!--近日课程：宽尺寸双列布局，中间竖线覆盖整个滚动区域并保持连续。 -->
<LinearLayout
 xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root"
 android:layout_width="match_parent"
 android:layout_height="match_parent"
 android:background="@drawable/widget_today_bg"
 android:orientation="vertical"
 android:paddingLeft="10dp"
 android:paddingRight="10dp"
 android:paddingTop="6dp"
 android:paddingBottom="8dp">

 <LinearLayout
 android:layout_width="match_parent"
 android:layout_height="wrap_content"
 android:gravity="center_vertical"
 android:orientation="horizontal">

 <TextView
 android:id="@+id/tv_header"
 android:layout_width="0dp"
 android:layout_height="wrap_content"
 android:layout_weight="1"
 android:contentDescription="点击刷新课程"
 android:ellipsize="end"
 android:maxLines="1"
 android:text="近日课程"
 android:textColor="@color/widget_header_text"
 android:textSize="12sp"
 android:textStyle="bold" />

 <TextView
 android:id="@+id/tv_subtitle"
 android:layout_width="wrap_content"
 android:layout_height="wrap_content"
 android:text="近三天"
 android:textColor="@color/widget_subtitle_text"
 android:textSize="10sp" />
 </LinearLayout>

 <TextView
 android:id="@+id/divider_top"
 android:layout_width="match_parent"
 android:layout_height="1dp"
 android:layout_marginTop="4dp"
 android:layout_marginBottom="3dp"
 android:background="@color/widget_divider" />

 <LinearLayout
 android:layout_width="match_parent"
 android:layout_height="wrap_content"
 android:gravity="center_vertical"
 android:orientation="horizontal">

 <TextView
 android:id="@+id/wide_header_today"
 android:layout_width="0dp"
 android:layout_height="wrap_content"
 android:layout_weight="1"
 android:ellipsize="end"
 android:maxLines="1"
 android:paddingEnd="4dp"
 android:text="今天"
 android:textColor="@color/widget_accent"
 android:textSize="10sp"
 android:textStyle="bold" />

 <TextView
 android:id="@+id/wide_header_column_divider"
 android:layout_width="1dp"
 android:layout_height="16dp"
 android:background="@color/widget_divider" />

 <TextView
 android:id="@+id/wide_header_tomorrow"
 android:layout_width="0dp"
 android:layout_height="wrap_content"
 android:layout_weight="1"
 android:ellipsize="end"
 android:maxLines="1"
 android:paddingStart="4dp"
 android:text="明天"
 android:textColor="@color/widget_accent"
 android:textSize="10sp"
 android:textStyle="bold" />
 </LinearLayout>

 <TextView
 android:id="@+id/wide_header_underline"
 android:layout_width="match_parent"
 android:layout_height="1dp"
 android:layout_marginTop="3dp"
 android:background="@color/widget_divider" />

 <FrameLayout
 android:layout_width="match_parent"
 android:layout_height="0dp"
 android:layout_weight="1">

 <ListView
 android:id="@+id/widget_wide_list_view"
 android:layout_width="match_parent"
 android:layout_height="match_parent"
 android:divider="@null"
 android:dividerHeight="0dp"
 android:scrollbars="none" />

 <TextView
 android:id="@+id/wide_center_divider"
 android:layout_width="1dp"
 android:layout_height="match_parent"
 android:layout_gravity="center_horizontal"
 android:background="@color/widget_divider" />
 </FrameLayout>
</LinearLayout>
